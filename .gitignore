# Build trees and logs
build/
build-*/
build-*.log
cmake-build-*/

# Licensed typefaces: see assets/fonts/README.md. The .otf files live outside
# the repo entirely; .bmo-fontdir records where, and is per-machine.
assets/fonts/*.otf
assets/fonts/*.ttf
.bmo-fontdir

# Planning documents and tester packages stay local
plans/
packages/

# Field audio, blind listening sets and their answers and keys. The source
# material is not necessarily ours to publish and this fork is public.
# AGENTS.md has carried "field audio, blind sets and the licensed fonts are
# never committed" since Tune arrived on 2026-09-11, but nothing enforced it
# here until 2026-09-12 -- the standalone tune repository ignored this same
# path, and that rule did not come across with the code.
field-audio/

# Rendered panels (regenerate with tools/snapshot)
snapshots/

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
*.log

# Compiled local analysis harnesses. Both are csc-built from a single .cs and
# deliberately outside CMake; see each one's README.
tools/measure/renders/*.exe
tools/inspect/*.exe

# The corpus scorer's working folders (scripts/score-corpus.sh): the generator is
# the source of truth and regenerates the same bytes, and renders/ holds
# renders of the field takes, which are never committed. Nothing enforced
# this until a commit on 2026-09-14 swept all three in.
corpus/
renders/
reports/
